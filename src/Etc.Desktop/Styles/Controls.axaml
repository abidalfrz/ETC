<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource Etc.Color.Ground}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Text}"/><Setter Property="FontFamily" Value="{StaticResource Etc.Font}"/><Setter Property="FontSize" Value="{StaticResource Etc.Type.Body}"/></Style>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Text}"/><Setter Property="FontFamily" Value="{StaticResource Etc.Font}"/><Setter Property="FontSize" Value="{StaticResource Etc.Type.Body}"/><Setter Property="LineHeight" Value="20"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="{StaticResource Etc.Type.Title}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="LineHeight" Value="40"/></Style>
  <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="{StaticResource Etc.Type.Section}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LineHeight" Value="26"/></Style>
  <Style Selector="TextBlock.kpi"><Setter Property="FontSize" Value="{StaticResource Etc.Type.Kpi}"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="LineHeight" Value="32"/></Style>
  <Style Selector="TextBlock.kpi, TextBlock.numeric"><Setter Property="FontFeatures" Value="tnum"/></Style>
  <Style Selector="Button.primary TextBlock"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.OnPrimary}"/></Style>
  <Style Selector="Button.primary PathIcon"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.OnPrimary}"/></Style>
  <Style Selector="Button.primary:disabled TextBlock"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Muted}"/></Style>
  <Style Selector="Button.primary:disabled PathIcon"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Muted}"/></Style>
  <Style Selector="Button.nav.active TextBlock"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.AccentInk}"/></Style>
  <Style Selector="Button.account TextBlock"><Setter Property="MaxWidth" Value="160"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Muted}"/></Style>
  <Style Selector="TextBlock.small"><Setter Property="FontSize" Value="{StaticResource Etc.Type.Small}"/><Setter Property="LineHeight" Value="18"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Muted}"/></Style>
  <Style Selector="TextBlock.label"><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style Selector="Button"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="14,6"/><Setter Property="CornerRadius" Value="{StaticResource Etc.Radius.Control}"/><Setter Property="Background" Value="{DynamicResource Etc.Color.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Etc.Color.ControlBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource Etc.Color.Primary}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.OnPrimary}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button"><Setter Property="RenderTransform" Value="scale(1)"/><Setter Property="RenderTransformOrigin" Value="50%,50%"/><Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource Etc.Motion.Feedback}"/></Transitions></Setter></Style>
  <Style Selector="Button:pressed"><Setter Property="RenderTransform" Value="scale(0.98)"/></Style>
  <Style Selector="Button.tertiary"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.DangerInk}"/></Style>
  <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.nav.active"><Setter Property="Background" Value="{DynamicResource Etc.Color.AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.AccentInk}"/></Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Etc.Color.Raised}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Text}"/></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Etc.Color.PrimaryHover}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.OnPrimary}"/></Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Etc.Color.PrimaryHover}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.OnPrimary}"/></Style>
  <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Etc.Color.AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.AccentInk}"/></Style>
  <Style Selector="Button.nav.nav-profile, Button.nav.nav-logout"><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style Selector="Button.nav.nav-profile"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.NavProfile}"/></Style>
  <Style Selector="Button.nav.nav-profile TextBlock"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.NavProfile}"/></Style>
  <Style Selector="Button.nav.nav-profile PathIcon"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.NavProfile}"/></Style>
  <Style Selector="Button.nav.nav-logout"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.NavLogout}"/></Style>
  <Style Selector="Button.nav.nav-logout TextBlock"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.NavLogout}"/></Style>
  <Style Selector="Button.nav.nav-logout PathIcon"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.NavLogout}"/></Style>
  <Style Selector="Button.nav.nav-profile:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Button.nav.nav-logout:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource Etc.Color.Focus}"/></Style>
  <Style Selector="Button.nav.nav-profile:disabled, Button.nav.nav-logout:disabled"><Setter Property="Background" Value="{DynamicResource Etc.Color.Raised}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Muted}"/></Style>
  <Style Selector="Button.nav.nav-profile:disabled TextBlock, Button.nav.nav-logout:disabled TextBlock"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Muted}"/></Style>
  <Style Selector="Button.nav.nav-profile:disabled PathIcon, Button.nav.nav-logout:disabled PathIcon"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Muted}"/></Style>
  <Style Selector="Button.nav.nav-profile:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.nav.nav-logout:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Etc.Color.Raised}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Muted}"/></Style>
  <Style Selector="Button:disabled"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Muted}"/><Setter Property="Background" Value="{DynamicResource Etc.Color.Raised}"/></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="40"/><Setter Property="Background" Value="{DynamicResource Etc.Color.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Etc.Color.ControlBorder}"/><Setter Property="CornerRadius" Value="{StaticResource Etc.Radius.Control}"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="40"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource Etc.Color.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Etc.Color.ControlBorder}"/></Style>
  <Style Selector="CheckBox"><Setter Property="MinHeight" Value="32"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.Text}"/></Style>
  <Style Selector="CheckBox:checked /template/ Path#CheckGlyph"><Setter Property="Fill" Value="{DynamicResource Etc.Color.OnPrimary}"/></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Etc.Color.AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.AccentInk}"/></Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Etc.Color.AccentSoft}"/></Style>
  <Style Selector="ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.AccentInk}"/></Style>
  <Style Selector=":is(Control)"><Setter Property="FocusAdorner"><Template><Border BorderBrush="{DynamicResource Etc.Color.Focus}" BorderThickness="2" CornerRadius="8" Margin="-4" IsHitTestVisible="False"/></Template></Setter></Style>
  <Style Selector="Border.panel"><Setter Property="Padding" Value="24"/><Setter Property="CornerRadius" Value="{StaticResource Etc.Radius.Panel}"/><Setter Property="Background" Value="{DynamicResource Etc.Color.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Etc.Color.Border}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Border.row"><Setter Property="Padding" Value="0,16"/><Setter Property="BorderBrush" Value="{DynamicResource Etc.Color.Rule}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style Selector="Border.list-card"><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="CornerRadius" Value="{StaticResource Etc.Radius.Panel}"/><Setter Property="Background" Value="{DynamicResource Etc.Color.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Etc.Color.Border}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Border.list-card:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource Etc.Color.ControlBorder}"/></Style>
  <Style Selector="Border.mentor-card"><Setter Property="Transitions"><Transitions><BrushTransition Property="BorderBrush" Duration="{DynamicResource Etc.Motion.Feedback}"/></Transitions></Setter></Style>
  <Style Selector="Button.mentor-skill"><Setter Property="Background" Value="{DynamicResource Etc.Color.Raised}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style Selector="TextBox.mentor-search /template/ TextBlock#PART_Placeholder"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="Button.mentor-skill:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Etc.Color.AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.AccentInk}"/></Style>
  <Style Selector="Border.activity"><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="CornerRadius" Value="{StaticResource Etc.Radius.Control}"/><Setter Property="Background" Value="{DynamicResource Etc.Color.Raised}"/></Style>
  <Style Selector="Border.card-actions"><Setter Property="BorderBrush" Value="{DynamicResource Etc.Color.Rule}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="0,12,0,0"/></Style>
  <Style Selector="Border.position-summary"><Setter Property="Background" Value="{DynamicResource Etc.Color.Raised}"/><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="4"/></Style>
  <Style Selector="Button.metric"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="16"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="Button.saved"><Setter Property="Background" Value="{DynamicResource Etc.Color.AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Etc.Color.AccentInk}"/></Style>
  <Style Selector="Button.saved TextBlock"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.AccentInk}"/></Style>
  <Style Selector="PathIcon.inline"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Border.status"><Setter Property="Padding" Value="8,3"/><Setter Property="CornerRadius" Value="{StaticResource Etc.Radius.Status}"/><Setter Property="Background" Value="{DynamicResource Etc.Color.NeutralSoft}"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
  <Style Selector="Border.status TextBlock"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.NeutralInk}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="Border.status.accepted"><Setter Property="Background" Value="{DynamicResource Etc.Color.SuccessSoft}"/></Style><Style Selector="Border.status.accepted TextBlock"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.SuccessInk}"/></Style>
  <Style Selector="Border.status.rejected"><Setter Property="Background" Value="{DynamicResource Etc.Color.DangerSoft}"/></Style><Style Selector="Border.status.rejected TextBlock"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.DangerInk}"/></Style>
  <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource Etc.Color.QuotaFill}"/><Setter Property="Background" Value="{DynamicResource Etc.Color.QuotaTrack}"/><Setter Property="Height" Value="4"/><Setter Property="MinHeight" Value="4"/></Style>
</Styles>
