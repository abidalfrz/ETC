<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Etc.Desktop.Features.Applications" x:Class="Etc.Desktop.Features.Applications.MyApplicationsView" x:DataType="vm:MyApplicationsViewModel">
  <StackPanel Spacing="24">
    <TextBlock Text="Lihat hasil seleksi dan riwayat lamaran Anda." Classes="muted"/>
    <Border Classes="panel" IsVisible="{Binding !HasItems}"><StackPanel Spacing="12"><TextBlock Text="Belum ada lamaran." Classes="section"/><TextBlock Text="Cari rekrutmen dan pilih posisi yang sesuai dengan skill Anda." Classes="muted"/><Button Content="Cari rekrutmen" Command="{Binding SearchCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
    <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MyApplicationRow">
      <Border Classes="list-card"><StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{Binding RecruitmentTitle}" Classes="section"/><Border Grid.Column="1" Classes="status" Classes.accepted="{Binding IsAccepted}" Classes.rejected="{Binding IsRejected}" VerticalAlignment="Top"><TextBlock Text="{Binding StatusText}"/></Border></Grid>
        <Border Classes="position-summary"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><PathIcon Classes="inline" Data="{ReflectionBinding Source=team,Converter={StaticResource Icon}}"/><TextBlock Grid.Column="1" Text="{Binding PositionName}" FontWeight="Medium"/></Grid></Border>
        <TextBlock Text="{Binding SubmittedText}" Classes="small"/>
        <Border Classes="card-actions"><WrapPanel>
          <Button Command="{ReflectionBinding $parent[UserControl].DataContext.OpenCommand}" CommandParameter="{Binding RecruitmentId}" Margin="0,0,12,8"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="inline" Data="{ReflectionBinding Source=document,Converter={StaticResource Icon}}"/><TextBlock Text="Lihat rekrutmen"/></StackPanel></Button>
          <Button Classes="danger" Content="Batalkan lamaran" IsVisible="{Binding CanCancel}" Command="{ReflectionBinding $parent[UserControl].DataContext.CancelCommand}" CommandParameter="{Binding}" Margin="0,0,0,8"/>
        </WrapPanel></Border>
      </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <WrapPanel><TextBlock Text="{Binding PagingText}" Classes="muted" VerticalAlignment="Center" Margin="0,0,24,8"/><Button Content="Sebelumnya" Command="{Binding PreviousCommand}" Margin="0,0,12,8"/><Button Content="Berikutnya" Command="{Binding NextCommand}"/></WrapPanel>
  </StackPanel>
</UserControl>
