<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Etc.Desktop.Features.Applications" xmlns:s="using:Etc.Desktop.Shared" x:Class="Etc.Desktop.Features.Applications.ApplicantsView" x:DataType="vm:ApplicantsViewModel">
  <StackPanel Spacing="24"><TextBlock Text="{Binding RecruitmentTitle}" Classes="section"/><Border Classes="panel" IsVisible="{Binding ShowList}"><StackPanel Spacing="12"><TextBlock Text="Kuota anggota" Classes="section"/><TextBlock Text="{Binding QuotaText}"/><Button Content="Muat ulang" HorizontalAlignment="Left" Command="{Binding RefreshCommand}"/></StackPanel></Border>
    <StackPanel Spacing="8" IsVisible="{Binding ShowList}"><TextBlock Text="Posisi pelamar" Classes="label"/><ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding SelectedPosition}" AutomationProperties.Name="Filter posisi pelamar"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PositionFilter"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="Terapkan filter posisi" HorizontalAlignment="Left" Command="{Binding RefreshCommand}"/></StackPanel>
    <TextBlock Text="Belum ada pelamar untuk posisi yang dipilih." Classes="muted" IsVisible="{Binding !HasItems}"/>
    <s:AdaptiveGrid IsVisible="{Binding HasItems}" SideWidth="480">
      <StackPanel Spacing="16" IsVisible="{Binding ShowList}"><TextBlock Text="Daftar pelamar" Classes="section"/><ListBox x:Name="ApplicantList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedApplicant}" Background="Transparent" BorderThickness="0" MaxHeight="600"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:ApplicantRow"><StackPanel Spacing="8" Margin="0,8"><TextBlock Text="{Binding Applicant.FullName}" FontWeight="SemiBold"/><TextBlock Text="{Binding PositionName}" Classes="small"/><Border Classes="status" Classes.accepted="{Binding IsAccepted}" Classes.rejected="{Binding IsRejected}"><TextBlock Text="{Binding StatusText}"/></Border><Button Content="Tinjau pelamar" Command="{ReflectionBinding $parent[UserControl].DataContext.ReviewCommand}" CommandParameter="{Binding}" HorizontalAlignment="Left"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><TextBlock Text="{Binding PagingText}" Classes="small" Margin="0,0,16,8"/><Button Content="Sebelumnya" Command="{Binding PreviousCommand}" Margin="0,0,12,8"/><Button Content="Berikutnya" Command="{Binding NextCommand}"/></WrapPanel></StackPanel>
      <Border x:Name="ApplicantDetail" Classes="panel" IsVisible="{Binding ShowDetail}" VerticalAlignment="Top"><StackPanel Spacing="16">
        <Button x:Name="BackToApplicants" Content="Kembali ke daftar pelamar" Command="{Binding BackToListCommand}" IsVisible="{Binding IsCompact}" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding SelectedApplicant.Applicant.FullName}" Classes="section"/><TextBlock Text="{Binding SelectedApplicant.PositionName}" Classes="muted"/><TextBlock Text="{Binding SelectedApplicant.Applicant.SkillText}"/>
        <TextBlock Text="Pengalaman" Classes="label"/><TextBlock Text="{Binding SelectedApplicant.Applicant.Experience}"/><TextBlock Text="Pesan lamaran" Classes="label"/><TextBlock Text="{Binding SelectedApplicant.Message}"/>
        <SelectableTextBlock Text="{Binding SelectedApplicant.PortfolioUrl}" TextWrapping="Wrap"/>
        <Button Content="Buka portofolio lamaran" Command="{Binding PortfolioCommand}" IsEnabled="{Binding SelectedApplicant.HasPortfolio}"/><TextBlock Text="Portofolio lamaran belum dicantumkan." Classes="small" IsVisible="{Binding !SelectedApplicant.HasPortfolio}"/>
        <Button Content="Buka profil mahasiswa" Command="{Binding ProfileCommand}"/><TextBlock Text="{Binding SelectedApplicant.StatusText}" FontWeight="Medium"/>
        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding SelectedApplicant.CanDecide}" IsEnabled="{Binding !IsBusy}"><Button Classes="primary" Content="Terima" Command="{Binding AcceptCommand}"/><Button Classes="danger" Content="Tolak" Command="{Binding RejectCommand}"/></StackPanel><TextBlock Text="Keputusan seleksi bersifat final pada versi demonstrasi." Classes="small"/>
      </StackPanel></Border>
    </s:AdaptiveGrid>
  </StackPanel>
</UserControl>
