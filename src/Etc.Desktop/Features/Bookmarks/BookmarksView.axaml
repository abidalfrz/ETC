<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Etc.Desktop.Features.Bookmarks" xmlns:r="using:Etc.Desktop.Features.Recruitments" x:Class="Etc.Desktop.Features.Bookmarks.BookmarksView" x:DataType="vm:BookmarksViewModel">
  <StackPanel Spacing="24">
    <TextBlock Text="Rekrutmen yang Anda simpan, termasuk yang sudah ditutup." Classes="muted"/>
    <Border Classes="panel" IsVisible="{Binding !HasItems}"><StackPanel Spacing="12"><TextBlock Text="Belum ada rekrutmen yang disimpan." Classes="section"/><TextBlock Text="Simpan rekrutmen yang menarik agar mudah Anda temukan kembali." Classes="muted"/><Button Content="Cari rekrutmen" Command="{Binding SearchCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
    <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="r:RecruitmentSummary">
      <Border Classes="list-card"><StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="4"><TextBlock Classes="section" Text="{Binding Title}"/><TextBlock Text="{Binding CategoryText}" Classes="small"/></StackPanel><Border Grid.Column="1" Classes="status" VerticalAlignment="Top" MaxWidth="200"><TextBlock Text="{Binding StatusText}"/></Border></Grid>
        <Border Classes="position-summary"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><PathIcon Classes="inline" VerticalAlignment="Top" Margin="0,2,0,0" Data="{ReflectionBinding Source=team,Converter={StaticResource Icon}}"/><TextBlock Grid.Column="1" Text="{Binding PositionsText}"/></Grid></Border>
        <TextBlock Text="{Binding DeadlineText,StringFormat='Tenggat: {0}'}" Classes="small"/>
        <Border Classes="card-actions"><WrapPanel>
          <Button Command="{ReflectionBinding $parent[UserControl].DataContext.OpenCommand}" CommandParameter="{Binding Id}" Margin="0,0,12,8"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="inline" Data="{ReflectionBinding Source=document,Converter={StaticResource Icon}}"/><TextBlock Text="Lihat posisi"/></StackPanel></Button>
          <Button Classes="saved" Command="{ReflectionBinding $parent[UserControl].DataContext.RemoveCommand}" CommandParameter="{Binding Id}" Margin="0,0,0,8"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="inline" Data="{ReflectionBinding Source=bookmark,Converter={StaticResource Icon}}"/><TextBlock Text="Hapus bookmark"/></StackPanel></Button>
        </WrapPanel></Border>
      </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <WrapPanel><TextBlock Text="{Binding PagingText}" Classes="muted" VerticalAlignment="Center" Margin="0,0,24,8"/><Button Content="Sebelumnya" Command="{Binding PreviousCommand}" Margin="0,0,12,8"/><Button Content="Berikutnya" Command="{Binding NextCommand}"/></WrapPanel>
  </StackPanel>
</UserControl>
