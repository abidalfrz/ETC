<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Etc.Desktop.Features.Recruitments" xmlns:s="using:Etc.Desktop.Shared" x:Class="Etc.Desktop.Features.Recruitments.RecruitmentFormView" x:DataType="vm:RecruitmentFormViewModel">
  <StackPanel Spacing="24">
    <TextBlock Text="Lengkapi kegiatan, posisi, dan tenggat. Kolom * wajib saat publikasi; draft dapat disimpan lebih dahulu." Classes="muted"/>
    <Border Classes="panel"><StackPanel Spacing="16"><TextBlock Classes="section" Text="Kegiatan"/>
      <StackPanel Spacing="8"><TextBlock Text="Judul rekrutmen *" Classes="label"/><TextBox Text="{Binding TitleText}" MaxLength="200" AutomationProperties.Name="Judul rekrutmen"/></StackPanel>
      <s:AdaptiveGrid Breakpoint="700" SideWidth="0"><StackPanel Spacing="8"><TextBlock Text="Kategori *" Classes="label"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Kategori rekrutmen"/></StackPanel><StackPanel Spacing="8"><TextBlock Text="Nama lomba/proyek *" Classes="label"/><TextBox Text="{Binding ActivityName}" MaxLength="200" AutomationProperties.Name="Nama kegiatan"/></StackPanel></s:AdaptiveGrid>
      <StackPanel Spacing="8"><TextBlock Text="Deskripsi *" Classes="label"/><TextBox Text="{Binding Description}" MaxLength="10000" MinHeight="140" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Deskripsi kegiatan"/></StackPanel>
      <s:AdaptiveGrid Breakpoint="700" SideWidth="0"><StackPanel Spacing="8"><TextBlock Text="Mode kegiatan *" Classes="label"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Mode kegiatan"/></StackPanel><StackPanel Spacing="8"><TextBlock Text="Lokasi (wajib untuk offline/hybrid)" Classes="label"/><TextBox Text="{Binding Location}" MaxLength="500" AutomationProperties.Name="Lokasi kegiatan"/></StackPanel></s:AdaptiveGrid>
    </StackPanel></Border>
    <Border Classes="panel"><StackPanel Spacing="16"><TextBlock Classes="section" Text="Posisi anggota"/><TextBlock Text="Posisi, skill, dan kuota terkunci setelah ada lamaran." Classes="muted"/>
      <ItemsControl ItemsSource="{Binding Positions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PositionEditor"><Border Classes="row"><StackPanel Spacing="16" IsEnabled="{ReflectionBinding $parent[UserControl].DataContext.CanEditPositions}">
        <s:AdaptiveGrid Breakpoint="700" SideWidth="0"><StackPanel Spacing="8"><TextBlock Text="Nama posisi *" Classes="label"/><TextBox Text="{Binding Name}" MaxLength="120" AutomationProperties.Name="Nama posisi anggota"/></StackPanel><StackPanel Spacing="8"><TextBlock Text="Kuota *" Classes="label"/><TextBox Text="{Binding Capacity}" MaxLength="9" AutomationProperties.Name="Kuota posisi"/></StackPanel></s:AdaptiveGrid>
        <TextBlock Text="Skill yang dibutuhkan *" Classes="label"/><ItemsControl ItemsSource="{Binding Skills}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="s:SkillChoice"><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,20,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Button Classes="danger" Content="Hapus posisi" HorizontalAlignment="Left" Command="{ReflectionBinding $parent[UserControl].DataContext.RemovePositionCommand}" CommandParameter="{Binding}"/>
      </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Button Content="Tambah posisi" Command="{Binding AddPositionCommand}" HorizontalAlignment="Left" IsVisible="{Binding CanEditPositions}"/>
    </StackPanel></Border>
    <Border Classes="panel"><StackPanel Spacing="16"><TextBlock Classes="section" Text="Jadwal dan biaya"/><TextBlock Text="Tenggat pendaftaran tim berbeda dari jadwal kegiatan. Semua waktu pendaftaran menggunakan WIB." Classes="muted"/>
      <s:AdaptiveGrid Breakpoint="700" SideWidth="0"><StackPanel Spacing="8"><TextBlock Text="Tanggal tenggat pendaftaran *" Classes="label"/><DatePicker SelectedDate="{Binding Deadline}" IsEnabled="{Binding CanEditDeadline}" AutomationProperties.Name="Tanggal tenggat pendaftaran tim"/></StackPanel><StackPanel Spacing="8"><TextBlock Text="Waktu tenggat (WIB) *" Classes="label"/><TimePicker SelectedTime="{Binding DeadlineTime}" ClockIdentifier="24HourClock" IsEnabled="{Binding CanEditDeadline}" AutomationProperties.Name="Waktu tenggat WIB"/></StackPanel></s:AdaptiveGrid>
      <TextBlock Text="Tenggat tidak dapat diubah jika pendaftaran sudah tidak tersedia." Classes="small" IsVisible="{Binding !CanEditDeadline}"/>
      <s:AdaptiveGrid Breakpoint="700" SideWidth="0"><StackPanel Spacing="8"><TextBlock Text="Kegiatan mulai (opsional)" Classes="label"/><DatePicker SelectedDate="{Binding StartsOn}" AutomationProperties.Name="Tanggal kegiatan mulai"/></StackPanel><StackPanel Spacing="8"><TextBlock Text="Kegiatan selesai (opsional)" Classes="label"/><DatePicker SelectedDate="{Binding EndsOn}" AutomationProperties.Name="Tanggal kegiatan selesai"/></StackPanel></s:AdaptiveGrid>
      <StackPanel Spacing="8"><TextBlock Text="Informasi biaya *" Classes="label"/><ComboBox ItemsSource="{Binding Fees}" SelectedItem="{Binding Fee}" AutomationProperties.Name="Jenis biaya"/></StackPanel>
      <StackPanel Spacing="8" IsVisible="{Binding IsPaid}"><TextBlock Text="Nominal rupiah *" Classes="label"/><TextBox Text="{Binding FeeAmount}" MaxLength="24" AutomationProperties.Name="Nominal biaya rupiah" Watermark="150.000,00"/><TextBlock Text="Peruntukan biaya *" Classes="label"/><TextBox Text="{Binding FeeNote}" MaxLength="2000" TextWrapping="Wrap" AutomationProperties.Name="Peruntukan biaya"/></StackPanel>
    </StackPanel></Border>
    <Border Classes="panel"><StackPanel Spacing="16"><TextBlock Text="Kontak" Classes="section"/><StackPanel Spacing="8"><TextBlock Text="Nama contact person *" Classes="label"/><TextBox Text="{Binding ContactName}" MaxLength="120" AutomationProperties.Name="Nama contact person"/></StackPanel><StackPanel Spacing="8"><TextBlock Text="Kanal kontak yang dibagikan *" Classes="label"/><TextBox Text="{Binding ContactChannel}" MaxLength="500" AutomationProperties.Name="Kanal kontak"/></StackPanel><StackPanel Spacing="8"><TextBlock Text="Tautan informasi kegiatan (opsional)" Classes="label"/><TextBox Text="{Binding InfoUrl}" MaxLength="2048" AutomationProperties.Name="Tautan informasi kegiatan"/></StackPanel></StackPanel></Border>
    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Etc.Color.DangerInk}" IsVisible="{Binding HasError}"/>
    <WrapPanel><Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,12,8"/><Button Classes="primary" Content="Publikasikan" Command="{Binding PublishCommand}" IsVisible="{Binding IsDraft}" IsEnabled="{Binding !IsBusy}"/></WrapPanel>
  </StackPanel>
</UserControl>
