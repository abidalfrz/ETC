<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Etc.Desktop.Features.Profiles" xmlns:s="using:Etc.Desktop.Shared" x:Class="Etc.Desktop.Features.Profiles.ProfileView" x:DataType="vm:ProfileViewModel">
  <StackPanel Spacing="24">
    <Border Classes="panel"><StackPanel Spacing="16">
      <Grid ColumnDefinitions="72,*" ColumnSpacing="16"><Border Width="72" Height="72" CornerRadius="36" ClipToBounds="True" Background="{DynamicResource Etc.Color.Raised}"><Grid><TextBlock Text="{Binding Initials}" Classes="section" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Photo,Converter={StaticResource Photo}}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><TextBlock Classes="section" Text="{Binding FullName}"/><TextBlock Text="Data demonstrasi" Classes="small" IsVisible="{Binding IsDemo}"/></StackPanel></Grid>
      <StackPanel IsVisible="{Binding CanEdit}" Orientation="Horizontal" Spacing="12"><Button Content="Pilih foto" Command="{Binding ChoosePhotoCommand}"/><Button Content="Hapus foto" Command="{Binding RemovePhotoCommand}"/></StackPanel>
      <TextBlock Classes="small" Text="Foto opsional · PNG/JPEG, maksimal 2 MiB dan 4096 × 4096" IsVisible="{Binding CanEdit}"/>
    </StackPanel></Border>
    <s:AdaptiveGrid WideColumns="2" NarrowColumns="1" SideWidth="0" Breakpoint="800">
      <StackPanel Spacing="8"><TextBlock Text="Identitas" Classes="section"/><TextBlock Classes="muted" Text="Nama dan angkatan membantu mahasiswa mengenali Anda."/></StackPanel>
      <Border Classes="panel"><StackPanel Spacing="16"><StackPanel Spacing="8"><TextBlock Text="Nama lengkap *" Classes="label"/><TextBox Text="{Binding FullName}" MaxLength="120" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Nama lengkap"/></StackPanel><StackPanel Spacing="8"><TextBlock Text="Angkatan *" Classes="label"/><TextBox Text="{Binding Cohort}" MaxLength="4" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Angkatan" Watermark="2024"/></StackPanel><StackPanel Spacing="8"><TextBlock Text="Bio singkat" Classes="label"/><TextBox Text="{Binding Bio}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Bio singkat"/></StackPanel></StackPanel></Border>
      <StackPanel Spacing="8"><TextBlock Text="Skill" Classes="section"/><TextBlock Text="Pilih keahlian yang dapat Anda kontribusikan dalam tim." Classes="muted"/></StackPanel>
      <Border Classes="panel"><StackPanel Spacing="12"><TextBlock Text="{Binding SelectedSkillText}" IsVisible="{Binding !CanEdit}"/><ItemsControl ItemsSource="{Binding Skills}" IsVisible="{Binding CanEdit}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="s:SkillChoice"><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,20,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <StackPanel Spacing="8"><TextBlock Text="Pengalaman" Classes="section"/><TextBlock Text="Ceritakan proyek, peran, dan pengalaman yang relevan." Classes="muted"/></StackPanel>
      <Border Classes="panel"><StackPanel Spacing="8"><TextBlock Text="Pengalaman" Classes="label"/><TextBox Text="{Binding Experience}" MaxLength="10000" MinHeight="140" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Pengalaman"/></StackPanel></Border>
      <StackPanel Spacing="8"><TextBlock Text="Tautan profil" Classes="section"/><TextBlock Text="Portofolio dan LinkedIn bersifat opsional." Classes="muted"/></StackPanel>
      <Border Classes="panel"><StackPanel Spacing="16"><StackPanel Spacing="8"><TextBlock Text="Portofolio" Classes="label"/><TextBox Text="{Binding PortfolioUrl}" MaxLength="2048" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Tautan portofolio"/><Button Content="Buka portofolio" HorizontalAlignment="Left" Command="{Binding OpenPortfolioCommand}"/></StackPanel><StackPanel Spacing="8"><TextBlock Text="LinkedIn" Classes="label"/><TextBox Text="{Binding LinkedInUrl}" MaxLength="2048" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Tautan LinkedIn"/><Button Content="Buka LinkedIn" HorizontalAlignment="Left" Command="{Binding OpenLinkedInCommand}"/></StackPanel></StackPanel></Border>
    </s:AdaptiveGrid>
    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Etc.Color.DangerInk}" IsVisible="{Binding HasError}"/>
    <Button Classes="primary" Content="Simpan profil" Command="{Binding SaveCommand}" IsVisible="{Binding CanEdit}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left"/>
  </StackPanel>
</UserControl>
