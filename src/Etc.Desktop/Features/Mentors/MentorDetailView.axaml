<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Etc.Desktop.Features.Mentors" xmlns:p="using:Etc.Desktop.Features.Profiles" xmlns:s="using:Etc.Desktop.Shared" x:Class="Etc.Desktop.Features.Mentors.MentorDetailView" x:DataType="vm:MentorDetailViewModel">
  <StackPanel Spacing="24">
    <Border Classes="panel">
      <s:AdaptiveGrid Breakpoint="900" SideWidth="0">
        <Grid ColumnDefinitions="140,*" ColumnSpacing="20">
          <Border Width="140" Height="176" Background="{DynamicResource Etc.Color.Raised}" CornerRadius="6" ClipToBounds="True" VerticalAlignment="Top"><Grid><TextBlock Text="{Binding Detail.Summary.Initials}" Classes="section" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Detail.Summary.Photo,Converter={StaticResource Photo}}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Detail.Summary.Name,StringFormat='Foto mentor {0}'}"/></Grid></Border>
          <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding Detail.Summary.Name}" Classes="section"/>
            <TextBlock Text="{Binding Detail.Summary.CohortText}" Classes="muted"/>
            <TextBlock Text="{Binding Detail.Summary.StudentNumber,StringFormat='NRP {0}'}" Classes="small"/>
            <TextBlock Text="{Binding Detail.Summary.FocusText}" Foreground="{DynamicResource Etc.Color.AccentInk}"/>
            <TextBlock Text="Data demonstrasi" Classes="small" IsVisible="{Binding Detail.Summary.IsDemo}"/>
          </StackPanel>
        </Grid>
        <Border Classes="position-summary">
          <StackPanel Spacing="12">
            <TextBlock Text="Keahlian mentoring" Classes="label"/>
            <ItemsControl ItemsSource="{Binding Detail.Summary.Skills}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="p:SkillOption"><Border Classes="status" Margin="0,0,8,8" Padding="10,6"><TextBlock Text="{Binding Name}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Pilih mentor sesuai bidang yang ingin Anda pelajari." Classes="small"/>
          </StackPanel>
        </Border>
      </s:AdaptiveGrid>
    </Border>
    <s:AdaptiveGrid Breakpoint="1000" SideWidth="320">
      <Border Classes="panel" VerticalAlignment="Top"><StackPanel Spacing="16">
        <TextBlock Text="Pengalaman dan pencapaian" Classes="section"/>
        <TextBlock Text="{Binding ExperienceText}"/>
        <Button IsVisible="{Binding HasPortfolio}" Command="{Binding PortfolioCommand}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="inline" Data="{ReflectionBinding Source=document,Converter={StaticResource Icon}}"/><TextBlock Text="Buka portofolio"/></StackPanel></Button>
        <TextBlock Text="Pencapaian tambahan" Classes="label" IsVisible="{Binding HasAchievements}"/>
        <TextBlock Text="{Binding Detail.Achievements}" IsVisible="{Binding HasAchievements}"/>
      </StackPanel></Border>
      <Border Classes="panel" VerticalAlignment="Top"><StackPanel Spacing="16">
        <TextBlock Text="Ajukan mentoring" Classes="section"/>
        <TextBlock Text="{Binding FormReason}" Classes="muted"/>
        <Button Classes="primary" Command="{Binding RequestMentorCommand}" IsEnabled="{Binding CanRequestMentor}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Classes="inline" Data="{ReflectionBinding Source=support,Converter={StaticResource Icon}}"/><TextBlock Text="Butuh mentor?"/></StackPanel></Button>
        <TextBlock Text="Lengkapi formulir untuk mengajukan kebutuhan mentoring. Respons dan pelaksanaan sesi ditangani di luar ETC." Classes="small"/>
      </StackPanel></Border>
    </s:AdaptiveGrid>
  </StackPanel>
</UserControl>
